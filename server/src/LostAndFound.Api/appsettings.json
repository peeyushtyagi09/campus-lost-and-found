{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Mongo": {
    "ConnectionString": "",
    "DatabaseName": "lostandfound"
  },
  "Jwt": {
    "Issuer": "campus-lost-and-found",
    "Audience": "campus-lost-and-found-client",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "Encryption": {
    "Key": ""
  },
  "Storage": {
    "UploadPath": "uploads",
    "MaxPhotoBytes": 5242880
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "UploadPermitLimit": 20,
    "GlobalPermitLimit": 100,
    "WindowSeconds": 60
  },
  "AllowedHosts": "*"
}
