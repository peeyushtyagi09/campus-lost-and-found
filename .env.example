# Copy to .env before `docker compose up`. These values are for local development only.
# Generate a new JWT signing key (at least 32 bytes) and a new 32-byte AES key before any shared deployment.

MONGO_CONNECTION_STRING=mongodb://mongo:27017
MONGO_DATABASE_NAME=lostandfound

JWT_ISSUER=campus-lost-and-found
JWT_AUDIENCE=campus-lost-and-found-client
JWT_SIGNING_KEY=dev-only-signing-key-change-me-32b!
JWT_EXPIRY_MINUTES=60

# Base64 of 32 bytes. This example key is public and must not be used outside local development.
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

STORAGE_UPLOAD_PATH=/app/uploads
STORAGE_MAX_PHOTO_BYTES=5242880

CORS_ALLOWED_ORIGIN=http://localhost:8088

RATE_LIMIT_AUTH_PERMIT=10
RATE_LIMIT_UPLOAD_PERMIT=20
RATE_LIMIT_GLOBAL_PERMIT=100
RATE_LIMIT_WINDOW_SECONDS=60

API_PORT=8080
CLIENT_PORT=8088

# Empty means the browser calls the same origin (nginx proxies /api).
VITE_API_URL=

# M4 Retention & Email
RETENTION_DISPOSAL_DAYS=90
RETENTION_EXPIRED_ACCOUNT_DAYS=365
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM_ADDRESS=noreply@campus-lost-and-found.local
